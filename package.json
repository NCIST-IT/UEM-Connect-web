{
  "name": "uem-connect-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-safari-shortcut.mjs && vite",
    "start": "vite preview --host 0.0.0.0 --port 5177 --strictPort",
    "build": "node scripts/build-safari-shortcut.mjs --verify-installers && vite build",
    "lint": "oxlint",
    "test": "node scripts/build-safari-shortcut.mjs && node --test tests/*.test.js",
    "preview": "vite preview",
    "shortcut:build": "node scripts/build-safari-shortcut.mjs",
    "shortcut:package": "node scripts/build-safari-shortcut.mjs && python3 scripts/package-safari-shortcut.py"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/roboto-slab": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  }
}
